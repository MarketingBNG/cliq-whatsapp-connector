# --- Shared (multi-user) connector: npm start ---
# Public HTTPS URL where this server is hosted (http://localhost:3000 for local testing)
BASE_URL=https://cliq-mcp.example.com
# Long random string used to encrypt tokens. Changing it signs everyone out.
SECRET_KEY=
# Zoho "Server-based Application" client (api-console.zoho.com)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Data centre where the Zoho client was created: com | in | eu | com.au | jp
ZOHO_DC=com
# Set to true to enable the send_message tool
CLIQ_ALLOW_SEND=false
PORT=3000

# --- Local single-user mode only: npm run start:local ---
ZOHO_REFRESH_TOKEN=
